# ---------------------------------------------------------------------------
# Proofroom: multi-tenant client galleries + studio CRM for photographers
# Copy to .env.local for development. Set the same keys in Vercel → Settings →
# Environment Variables for the saas/ project (Root Directory = saas).
# ---------------------------------------------------------------------------

# Product name shown everywhere (change to rename the product).
NEXT_PUBLIC_APP_NAME=Proofroom
# Root domain the app runs on, no protocol. Studios get {slug}.APP_DOMAIN.
# Locally: localhost:3000 (tenants are then reachable at /t/{slug}/...).
NEXT_PUBLIC_APP_DOMAIN=proofroom.com
# Full public URL of the root site (protocol + APP_DOMAIN).
NEXT_PUBLIC_APP_URL=https://proofroom.com
# Support / from address shown to users.
NEXT_PUBLIC_SUPPORT_EMAIL=support@proofroom.com

# Neon Postgres (Neon → Connect → pooled connection string).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# 32+ random bytes for session signing, gallery cookies and token hashing.
#   openssl rand -base64 48
APP_SECRET=change-me

# Vercel Blob. Two stores: "galleries" (Private) and "assets" (Public, env prefix ASSETS).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
ASSETS_READ_WRITE_TOKEN=vercel_blob_rw_...

# Stripe (platform account). Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook endpoint for the PLATFORM account events (subscriptions):
#   https://APP_DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook endpoint for CONNECTED account events (client payments), "Listen to
# events on Connected accounts" in the Stripe dashboard:
#   https://APP_DOMAIN/api/stripe/connect-webhook
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Subscription prices. Create them with: npm run stripe:setup (prints these).
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_YEARLY=price_...
# Optional platform fee on client payments, in basis points (0 = no commission).
PLATFORM_FEE_BPS=0

# Resend (transactional email). Verify APP_DOMAIN in Resend first.
RESEND_API_KEY=re_...
EMAIL_FROM=Proofroom <hello@proofroom.com>

# Optional: Vercel API token + project id so custom domains can be added
# automatically from the studio settings page.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
