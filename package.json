{
  "name": "proofroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-env.mjs && next dev",
    "build": "node scripts/db-migrate.mjs --if-configured && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/db-migrate.mjs",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "plugin:zip": "node scripts/plugin-zip.mjs",
    "platform:admin": "node scripts/make-platform-admin.mjs",
    "env:check": "node scripts/check-env.mjs",
    "check": "bash scripts/check.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@vercel/blob": "^2.8.0",
    "fflate": "^0.8.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
